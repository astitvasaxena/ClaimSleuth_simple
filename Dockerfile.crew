# CrewAI image: Forensic Agent A2A service (requirements/crew.txt). Separate from the main image because
# crewai 1.15.33 and google-adk 2.13.0 need conflicting opentelemetry-api / mcp versions.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN useradd --uid 10001 --create-home claimsleuth
WORKDIR /app
COPY requirements/crew.txt requirements/crew.txt
RUN python -m venv /app/.venv-crew && /app/.venv-crew/bin/pip install -r requirements/crew.txt
COPY pyproject.toml README.md ./
COPY src src
COPY data data
RUN /app/.venv-crew/bin/pip install -e . \
 && mkdir -p /app/runtime && chown -R claimsleuth:claimsleuth /app/runtime
USER claimsleuth
ENV PATH=/app/.venv-crew/bin:$PATH CLAIMSLEUTH_RUNTIME_DIR=/app/runtime
# Shares the main container's network namespace (compose network_mode), so MCP and the dashboard see it on 127.0.0.1:8103.
CMD ["python", "-m", "claimsleuth.crew_service.a2a_server", "--port", "8103", \
     "--mcp-url", "http://127.0.0.1:8102/mcp", "--data-dir", "/app/runtime/dashboard/data"]
