# Copy to deploy/.env ON THE VM (never commit it). Single-quote values containing $.
# "auto" (default for a VM without a fixed IP): deploy/boot.sh sets <public-ip-with-dashes>.sslip.io at every boot. Or set your own hostname. ":80" = plain HTTP (local only).
SITE_ADDRESS=auto
BASIC_AUTH_USER=claimsleuth
# Generate: docker run --rm caddy:2 caddy hash-password --plaintext 'YOUR_PASSWORD'   (single-quote the result)
BASIC_AUTH_HASH=
# offline (default, no key, labelled test doubles) or live (needs GOOGLE_API_KEY, free tier is ~20 requests/day/model)
MODE=offline
GOOGLE_API_KEY=
# Auto-update (deploy/auto_update.sh, systemd timer claimsleuth-update): the VM follows this branch of this PUBLIC repo every minute.
# AUTO_UPDATE=off pauses it. Rolls back by itself if the new version does not become healthy.
REPO_URL=https://github.com/astitvasaxena/ClaimSleuth_simple.git
BRANCH=main
AUTO_UPDATE=on
