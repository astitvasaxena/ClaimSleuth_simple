# ClaimSleuth Simple - environment template (placeholders only).
# Copy to .env only if you need one of these. .env is gitignored; never commit it or paste its contents.
# Nothing here is needed for the default offline demonstration (python -m claimsleuth.dashboard).
# Optional settings are commented out; uncomment one only to change its default.

# --- Google ADK agents (Evidence + Investigator) ------------------------------------------------
# Gemini API key, only for live ADK runs from the command line (python -m claimsleuth.adk_service).
# Live Gemini runs have NOT been verified in this project; the dashboard always uses the offline test double.
GOOGLE_API_KEY=
# ADK command-line model mode: "gemini" (default, needs the key) or "test-double" (offline, labelled).
# CLAIMSLEUTH_ADK_LLM=test-double
# Gemini model name (default: the google-adk 2.13.0 default model).
# CLAIMSLEUTH_GEMINI_MODEL=<model-name>

# --- CrewAI Forensic Agent -------------------------------------------------------------------------
# "test-double" (default, offline) or "ollama-local" (local Ollama on 127.0.0.1 only; never a fallback).
# The dashboard sets this from its --crew-mode option.
# CLAIMSLEUTH_CREW_LLM=test-double
# ollama-local only. The model must already be pulled; ClaimSleuth never downloads models.
# CLAIMSLEUTH_OLLAMA_MODEL=qwen2.5:3b
# CLAIMSLEUTH_OLLAMA_URL=http://127.0.0.1:11434/v1

# --- Services --------------------------------------------------------------------------------------
# CLAIMSLEUTH_MCP_URL=http://127.0.0.1:8102/mcp
