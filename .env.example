# ClaimSleuth Simple - environment template (placeholders only).
# Copy to .env only if you need one of these. .env is gitignored; never commit it or paste its contents.
# Nothing here is needed for the default offline demonstration (python -m claimsleuth.dashboard).
# Optional settings are commented out; uncomment one only to change its default.

# --- Execution mode (all three agents) -----------------------------------------------------------
# offline (default): labelled offline test doubles, no key, no network. live: genuine Gemini inference for the
# Evidence, Investigator and Forensic Agents; missing key or a failed call is an explicit error, never a fallback.
# The dashboard's --mode and scripts\start_live.ps1 set this for you.
# EXECUTION_MODE=offline

# --- Gemini (used by EXECUTION_MODE=live) ----------------------------------------------------------
# Gemini API key (Google AI Studio). Read from here or the environment; never printed or logged.
GOOGLE_API_KEY=
# Gemini model name for all three agents (default gemini-3.5-flash, google-adk 2.13.0's default model).
# CLAIMSLEUTH_GEMINI_MODEL=gemini-3.5-flash
# Shared request budget for both agent processes (runtime/gemini_requests.sqlite3). Requests wait for a free
# per-minute slot and are refused, unsent, once the daily budget (since midnight Pacific) is used. Defaults are the
# free-tier limits Google reported for this project; raise them for a paid tier. RPD=0 turns the daily check off.
# CLAIMSLEUTH_GEMINI_RPM=5
# CLAIMSLEUTH_GEMINI_RPD=20
# CrewAI Forensic Agent limits in live mode (defaults shown; each is range-checked). Only an HTTP 503 is retried, once.
# CLAIMSLEUTH_GEMINI_MAX_CALLS=4
# CLAIMSLEUTH_GEMINI_RUN_BUDGET=300
# CLAIMSLEUTH_GEMINI_CALL_TIMEOUT=120
# CLAIMSLEUTH_GEMINI_MAX_ITER=2

# --- Google ADK agents (Evidence + Investigator) ------------------------------------------------
# Per-component override, only when EXECUTION_MODE is not set: "gemini" or "test-double" (offline, labelled).
# CLAIMSLEUTH_ADK_LLM=test-double

# --- CrewAI Forensic Agent -------------------------------------------------------------------------
# Per-component override, only when EXECUTION_MODE is not set: "test-double" (default), "gemini", or the
# experimental "ollama-local" (local Ollama on 127.0.0.1 only; never a fallback; not used by live mode).
# CLAIMSLEUTH_CREW_LLM=test-double
# ollama-local only. The model must already be pulled; ClaimSleuth never downloads models.
# CLAIMSLEUTH_OLLAMA_MODEL=qwen2.5:3b
# CLAIMSLEUTH_OLLAMA_URL=http://127.0.0.1:11434/v1

# --- Services --------------------------------------------------------------------------------------
# CLAIMSLEUTH_MCP_URL=http://127.0.0.1:8102/mcp
